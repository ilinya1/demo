# Docker Compose 部署环境变量示例
# 使用：复制为 .env 并修改（cp .env.example .env），然后 docker compose up -d
# 注意：这些变量会被 git 忽略，.env 不要提交到仓库

# MySQL root 密码（同时用于后端连接）
MYSQL_ROOT_PASSWORD=DormRoot123456!

# JWT 签名密钥：生产务必改为足够长的随机串（如 openssl rand -hex 32）
JWT_SECRET=change-me-to-a-strong-jwt-secret

# token 有效期（分钟），默认 720
JWT_EXPIRE_MINUTES=720

# 前端对外端口（默认 80）
APP_PORT=80